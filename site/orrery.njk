  <form class="orrery-sliders" aria-label="Controls for the chart" onsubmit="return false">
    <label>Orbit speed <output></output><input type="range" data-control="speed" min="0.05" max="3" step="0.01" value="0.43"></label>
    <label>History <output></output><input type="range" data-control="history" min="0.25" max="10" step="0.25" value="1"></label>
    <label>Scale <output></output><input type="range" data-control="scale" min="0" max="4" step="1" value="0"></label>
    <label>Dust <output></output><input type="range" data-control="dust" min="0.3" max="3" step="0.1" value="1"></label>
  </form>
</main>
