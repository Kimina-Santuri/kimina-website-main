---
layout: base.njk
permalink: residencies.html
title: Residencies
description: Artist residencies and research projects by Kimina.
currentPage: residencies
animation: orbits
---
<main>
  <p class="section-label">02 / Practice</p>
  <h1>Residencies</h1>
  <p class="page-intro">Research, experiments and work developed through artist residencies.</p>
  <div class="residency-list">
    {% for item in collections.publishedResidencies | reverse %}
    <article class="residency-item">
      <a class="residency-item__image-link" href="{{ item.url | relativeUrl }}" aria-label="View {{ item.data.title }} residency"><img class="residency-item__image" src="{{ item.data.image }}" alt="{{ item.data.image_alt }}" loading="lazy"></a>
      <div class="residency-item__meta"><p>{{ item.data.status | capitalize }} / {{ item.data.date | year }}</p><p>{{ item.data.location }}</p></div>
      <div class="residency-item__content">
        <h2><a href="{{ item.url | relativeUrl }}">{{ item.data.title }}</a></h2>
        <p>{{ item.data.summary | markdownInline | safe }}</p>
        <a class="text-link" href="{{ item.url | relativeUrl }}">View residency <span aria-hidden="true">↗</span></a>
      </div>
    </article>
    {% endfor %}
  </div>
</main>
